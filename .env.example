# Firebase web config. Copy to .env for local dev; set the same keys as
# build-time environment variables in Cloudflare Pages for deploys.
#
# These are CLIENT keys: Vite inlines them into the browser bundle, so they are
# not secret. Protect data with Firestore security rules + (optional) API-key
# restrictions and App Check — not by hiding these values.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
